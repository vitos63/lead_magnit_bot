POSTGRES_USER=lead_magnit
POSTGRES_PASSWORD=change_me
POSTGRES_DB=lead_magnit_bot

DATABASE_URL=postgresql+asyncpg://lead_magnit:change_me@db:5432/lead_magnit_bot

BOT_TOKEN=1234567890:AAExampleTokenFromBotFather
# Bot username without @ — YooKassa redirects here after payment
BOT_USERNAME=lead_magnit_bot
# Admin Telegram ID: receives request and purchase notifications, opens /admin
ADMIN_TG_ID=123456789

# HTTPS URL of the mini app (frontend) opened by the bot buttons
WEBAPP_URL=https://bot.example.com

# OpenRouter key for AI scoring of answers: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-example

# YooKassa shop ID and secret key (test_… for a test shop, live_… for production)
YOOKASSA_SHOP_ID=123456
YOOKASSA_SECRET_KEY=test_example
# Email that receives YooKassa fiscal receipts (54-FZ); the bot doesn't ask buyers for email
RECEIPT_EMAIL=receipts@example.com
