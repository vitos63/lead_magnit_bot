POSTGRES_USER=lead_magnit
POSTGRES_PASSWORD=change_me
POSTGRES_DB=lead_magnit_bot

DATABASE_URL=postgresql+asyncpg://lead_magnit:change_me@db:5432/lead_magnit_bot

BOT_TOKEN=1234567890:AAExampleTokenFromBotFather
# Bot username without @, used in the channel post button
BOT_USERNAME=example_bot
# Admin Telegram ID: receives review request notifications, opens /admin, publishes /post
ADMIN_TG_ID=123456789

# Channel for /post: @username or numeric ID (-100...); the bot must be its admin with posting rights
CHANNEL_ID=@example_channel

# HTTPS URL of the mini app (frontend) opened by the bot buttons
WEBAPP_URL=https://bot.example.com

# OpenRouter key for AI scoring of answers: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-example
